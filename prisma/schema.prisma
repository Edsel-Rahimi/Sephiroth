generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Sephiroth Panel ─────────────────────────────────────────
// Phase 1 · Auth & Security

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String // scrypt: "salt:hash"
  recoveryKey  String   @unique // e.g. SEPH-XXXX-XXXX-XXXX
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServerSetting {
  key   String @id // e.g. "session_secret"
  value String
}

// ── Sephiroth Panel ─────────────────────────────────────────
// Phase 3 · Inbounds (config source of truth; core-sim mirrors
// this table and decorates it with live traffic stats)

model Inbound {
  id        String   @id @default(cuid())
  tag       String   @unique // unique Xray inbound tag
  protocol  String // vless | vmess | trojan | shadowsocks | hysteria2
  port      Int      @unique // 1-65535
  transport String   @default("tcp") // tcp | ws | grpc | httpupgrade
  security  String   @default("none") // none | tls
  status    String   @default("online") // online | maintenance | disabled
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
