generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Sephiroth Panel ─────────────────────────────────────────
// Phase 1 · Auth & Security

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String // scrypt: "salt:hash"
  recoveryKey  String   @unique // e.g. SEPH-XXXX-XXXX-XXXX
  displayName  String? // friendly name shown in profile
  role         String   @default("owner") // task 3-b — owner | admin | viewer
  enabled      Boolean  @default(true) // task 3-b — disabled admins cannot sign in
  lastLoginAt  DateTime? // task 3-b — last successful sign-in
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServerSetting {
  key   String @id // e.g. "session_secret"
  value String
}

// ── Sephiroth Panel ─────────────────────────────────────────
// Phase 3 · Inbounds (config source of truth; core-sim mirrors
// this table and decorates it with live traffic stats)

model Inbound {
  id        String   @id @default(cuid())
  tag       String   @unique // unique Xray inbound tag
  protocol  String // vless | vmess | trojan | shadowsocks | hysteria2 | ...
  port      Int      @unique // 1-65535
  listen    String   @default("") // "" = all interfaces (0.0.0.0)
  transport String   @default("tcp") // tcp | ws | grpc | httpupgrade | xhttp
  security  String   @default("none") // none | tls | reality
  status    String   @default("online") // online | maintenance | disabled
  note      String?
  // limits
  trafficLimitGb Float? // null = unlimited
  expiryDays     Int? // null = never expires
  // complex config stored as JSON strings (validated on write)
  clientsJson  String  @default("[]") // [{email,key,subId,flow,ipLimit,trafficLimitGb,expiryDays,enabled,ownerId?}]
  sniffingJson String  @default("{}") // {enabled,destOverride[],routeOnly}
  streamJson   String  @default("{}") // transport/security-specific settings
  accesses UserInboundAccess[]
  hosts    Host[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Sephiroth Panel ─────────────────────────────────────────
// Phase 4 · Users (panel-level clients owning entries across
// inbounds; entries are projected into Inbound.clientsJson
// with ownerId so the core-facing config stays the same shape)

model ClientUser {
  id             String   @id @default(cuid())
  username       String   @unique // 2-32 chars [a-zA-Z0-9_-]
  subId          String   @unique // subscription token (hex)
  note           String?
  enabled        Boolean  @default(true)
  // limits apply to every linked config
  trafficLimitGb Float? // null = unlimited
  expiryDays     Int? // null = never expires
  ipLimit        Int      @default(0) // 0 = unlimited
  // simulated usage (decorated / resettable)
  usedTrafficGb  Float    @default(0)
  // traffic-counter reset policy (none | daily | weekly | monthly | null)
  resetPeriod    String?
  lastResetAt    DateTime?
  // 26-a — lifecycle: on-hold (clock starts at first connect) + auto-renew
  onHold         Boolean  @default(false)
  startedAt      DateTime? // first-connect anchor; null = clock not started
  autoRenew      Boolean  @default(false)
  renewals       Int      @default(0)
  expiryWarnedAt DateTime? // last near-expiry notification
  // Phase 6 hook: owning reseller, null = admin-created
  resellerId     String?
  reseller       Reseller? @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  // Task 23-c — Telegram linkage for the sales bot
  tgId           String?
  // Task 23-g — sub-portal HWID device gate
  hwidLimit      Int?
  devices        String   @default("[]") // JSON array of registered devices
  accesses       UserInboundAccess[]
  groupMembers   SubGroupMember[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserInboundAccess {
  id        String     @id @default(cuid())
  userId    String
  inboundId String
  email     String // identity inside the inbound (unique per inbound)
  key       String // uuid (vless/vmess) or password (trojan/ss/hy2/...)
  flow      String     @default("") // "" | xtls-rprx-vision (reality vless)
  user      ClientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  inbound   Inbound    @relation(fields: [inboundId], references: [id], onDelete: Cascade)

  @@unique([userId, inboundId])
  @@unique([inboundId, email])
  @@index([userId])
}

// ── Sephiroth Panel ─────────────────────────────────────────
// Phase 5 · Subscription — public /sub/[token] pages.
// A token resolves to either a ClientUser.subId (single user)
// or a SubGroup.token (multi-user group, optionally password
// protected). Members are unioned into one public page.

model SubGroup {
  id           String   @id @default(cuid())
  name         String // 1-48 chars
  token        String   @unique // 24 hex chars — public token
  passwordHash String? // scrypt "salt:hash", null = open page
  infoLine     String? // custom line rendered on the pass card
  enabled      Boolean  @default(true)
  members      SubGroupMember[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SubGroupMember {
  id      String     @id @default(cuid())
  groupId String
  userId  String
  group   SubGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    ClientUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ------------------------------------------------------------
// Phase 6 — Reseller system.
// A Reseller is a second login type (scoped operator): it can
// only see/manage the ClientUsers it owns (ClientUser.resellerId).
// Quotas cap how many users it may create (maxUsers) and how much
// traffic it may allocate across them (trafficQuotaGb, null =
// unlimited; while a quota is set, unlimited-traffic users are
// forbidden so the allocation stays finite). Deleting a reseller
// releases its users (resellerId → null), never deletes them.
// ------------------------------------------------------------

model Reseller {
  id             String       @id @default(cuid())
  username       String       @unique // 3-32 chars [a-zA-Z0-9_-]
  passwordHash   String // scrypt "salt:hash"
  note           String?
  enabled        Boolean      @default(true)
  maxUsers       Int? // null = unlimited user quota
  trafficQuotaGb Float? // null = unlimited traffic allocation
  // 26-c — white-label for this reseller's /sub pages
  brandName      String?
  brandLogo      String? // https or data URI
  brandAccent    String? // hex color
  users          ClientUser[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Sale templates — named presets (traffic/expiry/ipLimit) that
// appear as one-click chips in the user create dialog. Admin
// manages them; resellers consume the enabled ones.
model SaleTemplate {
  id             String   @id @default(cuid())
  name           String // 1-48 chars
  trafficLimitGb Float? // null = unlimited
  expiryDays     Int? // null = never expires
  ipLimit        Int      @default(0) // 0 = unlimited
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ------------------------------------------------------------
// Phase 8 — Core network objects (modeled on the 3x-ui panel).
// ------------------------------------------------------------

// Host — per-inbound share-link override (3x-ui "Hosts").
// Rewrites the address/port/SNI/path shown in share links and
// subscription entries without touching the core inbound itself.
model Host {
  id          String   @id @default(cuid())
  inboundId   String
  inbound     Inbound  @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  remark      String // 1-64 chars
  address     String // domain or IP used in links
  port        Int      @default(0) // 0 = inherit inbound port
  security    String   @default("same") // same | tls | none | reality
  sni         String   @default("")
  hostHeader  String   @default("")
  path        String   @default("")
  alpn        String   @default("") // comma separated
  fingerprint String   @default("") // uTLS fingerprint
  enable      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([inboundId])
}

// Node — remote panel node (3x-ui "Nodes"). A second Sephiroth
// instance the panel can sync inbounds to. State fields are
// decorated by the simulator driver in preview mode.
model Node {
  id          String    @id @default(cuid())
  name        String // 1-48 chars
  scheme      String    @default("https") // http | https
  address     String // host or IP
  port        Int       @default(443)
  basePath    String    @default("/")
  apiToken    String    @default("") // masked on read
  enable      Boolean   @default(true)
  syncAll     Boolean   @default(true) // true = all inbounds, false = selected tags
  inboundTags String    @default("[]") // JSON array of Inbound.tag when syncAll=false
  outboundTag String    @default("")
  tlsVerify   String    @default("verify") // verify | skip
  // live state (agent probes / pushes — see src/lib/nodes-sync.ts)
  status      String    @default("unknown") // online | offline | unknown
  latencyMs   Int       @default(0)
  xrayVersion String    @default("") // core version reported by the agent
  coreKind    String    @default("") // sim | xray ("" = never probed)
  lastSeen    DateTime?
  lastSyncAt  DateTime? // last successful config push
  lastError   String    @default("") // last agent-call error ("" = none)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Outbound — xray outbound proxy (3x-ui "Outbounds"). direct /
// blocked ship as defaults; additional protocol outbounds are
// user-defined. Traffic counters are simulated in preview.
model Outbound {
  id             String  @id @default(cuid())
  tag            String  @unique
  protocol       String // freedom | blackhole | dns | socks | http | vmess | vless | trojan | shadowsocks | wireguard
  sendThrough    String  @default("")
  domainStrategy String  @default("AsIs")
  settingsJson   String  @default("{}") // protocol-specific settings
  streamJson     String  @default("{}")
  muxEnabled     Boolean @default(false)
  muxConcurrency Int     @default(8)
  sortOrder      Int     @default(0)
  upBytes        Float   @default(0)
  downBytes      Float   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// RoutingRule — ordered xray routing rules (3x-ui "Routing").
// Lower sortOrder = evaluated first; bulk-saved with order.
model RoutingRule {
  id             String  @id @default(cuid())
  enabled        Boolean @default(true)
  comment        String  @default("")
  outboundTag    String  @default("direct")
  domainJson     String  @default("[]") // JSON string[]
  ipJson         String  @default("[]") // JSON string[]
  port           String  @default("") // "", "443", "1000-2000"
  network        String  @default("") // "" | tcp | udp | tcp,udp
  protocolJson   String  @default("[]") // JSON string[]
  inboundTagJson String  @default("[]") // JSON string[]
  sourceJson     String  @default("[]") // JSON string[]
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ------------------------------------------------------------
// Phase 27 — Public API tokens (Bearer auth for the REST API).
// A token delegates ADMIN-level access to external integrations
// (Marzban-style automation, billing glue, monitoring). The raw
// secret is shown exactly once at creation; only the sha256 hash
// lives in the store. `prefix` (first 12 chars) is kept for the
// management UI so owners can recognize a token without holding
// the secret. Actions taken with a token are attributed to the
// admin account that minted it (actorUsername).
// ------------------------------------------------------------
model ApiToken {
  id            String    @id @default(cuid())
  name          String // 1-48 chars, friendly label
  tokenHash     String    @unique // sha256 hex of "seph_<32hex>"
  prefix        String // display form: "seph_ab12cd34…"
  actorUsername String // admin that created the token
  enabled       Boolean   @default(true)
  lastUsedAt    DateTime?
  lastUsedIp    String    @default("")
  createdAt     DateTime  @default(now())
}

// ActivityLog — persisted audit trail. The dashboard feed streams
// socket events; this table keeps history with filters/export.
model ActivityLog {
  id        String   @id @default(cuid())
  kind      String // auth.login | auth.failed | inbound.* | user.* | sub.* | reseller.* | settings.updated | backup.* | system.*
  level     String   @default("info") // info | success | warn | error
  actor     String   @default("") // username performing the action
  message   String // human readable (EN)
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}
